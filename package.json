{
  "name": "nextjs-fastapi",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "fastapi-dev": "uv run --locked uvicorn api.index:app --reload",
    "next-dev": "next dev",
    "dev": "concurrently \"node --run next-dev\" \"node --run fastapi-dev\"",
    "build": "node --run generate:api && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "review:svg": "uv run --locked python scripts/generate_svg_visual_review.py",
    "fmt": "biome check --write ./app",
    "ts": "tsc --noEmit",
    "generate:api": "orval",
    "fetch:openapi": "uv run --locked python scripts/export_openapi.py"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gmod/gff": "^2.0.0",
    "@gmod/gtf": "^0.0.9",
    "@mantine/core": "^9.7.4",
    "@mantine/dropzone": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@tabler/icons-react": "^3.49.0",
    "autoprefixer": "10.6.2",
    "boxicons": "^2.1.4",
    "concurrently": "^10.0.0",
    "fuse.js": "^7.1.0",
    "next": "^16.3.4",
    "postcss": "^8.5.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-svg-pan-zoom": "^3.13.1",
    "swr": "^2.3.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-svg-pan-zoom": "^3.3.9",
    "orval": "^8.18.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
