{
  "name": "nextjs-fastapi",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "fastapi-dev": "pip3 install -r requirements.txt && python3 -m uvicorn api.index:app --reload",
    "next-dev": "next dev",
    "dev": "concurrently \"npm run next-dev\" \"npm run fastapi-dev\"",
    "build": "npm run generate:api && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "review:svg": "if [ -x venv/bin/python ]; then venv/bin/python scripts/generate_svg_visual_review.py; else python3 scripts/generate_svg_visual_review.py; fi",
    "fmt": "biome check --write ./app",
    "ts": "tsc --noEmit",
    "generate:api": "orval",
    "fetch:openapi": "python3 scripts/export_openapi.py"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gmod/gff": "^2.0.0",
    "@gmod/gtf": "^0.0.9",
    "@mantine/core": "^8.3.6",
    "@mantine/dropzone": "^8.3.6",
    "@mantine/hooks": "^8.3.6",
    "@mantine/notifications": "^8.3.6",
    "@tabler/icons-react": "^3.35.0",
    "autoprefixer": "10.4.20",
    "boxicons": "^2.1.4",
    "browserslist": "^4.28.1",
    "concurrently": "^9.2.3",
    "fuse.js": "^7.1.0",
    "next": "^16.2.9",
    "postcss": "^8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-svg-pan-zoom": "^3.13.1",
    "swr": "^2.3.3",
    "typescript": "5.6.2",
    "vitest": "^3.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-svg-pan-zoom": "^3.3.9",
    "orval": "^8.18.0"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "postcss": "$postcss",
    "rollup": ">=4.59.0"
  }
}
