{
  "name": "nextjs-fastapi",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "fastapi-dev": "pip3 install -r requirements.txt && python3 -m uvicorn api.index:app --reload",
    "next-dev": "next dev",
    "dev": "concurrently \"npm run next-dev\" \"npm run fastapi-dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "fmt": "biome check --write ./app",
    "ts": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^8.3.6",
    "@mantine/dropzone": "^8.3.6",
    "@mantine/hooks": "^8.3.6",
    "@tabler/icons-react": "^3.35.0",
    "@vercel/blob": "^0.27.3",
    "autoprefixer": "10.4.20",
    "boxicons": "^2.1.4",
    "concurrently": "^9.0.1",
    "fuse.js": "^7.1.0",
    "gff-nostream": "^1.3.4",
    "next": "^14.2.13",
    "postcss": "^8.4.47",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-svg-pan-zoom": "^3.13.1",
    "swr": "^2.3.3",
    "tailwind-preset-mantine": "^3.0.2",
    "typescript": "5.6.2",
    "vitest": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-svg-pan-zoom": "^3.3.9",
    "tailwindcss": "^4.1.16"
  }
}
